NODE_ENV=development
PORT=5000
# Native direct API: zero. Container gateway deployment: one trusted proxy hop.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://ticketchain:localdemo@localhost:5432/ticketchain_demo
TEST_DATABASE_URL=postgresql://ticketchain:localdemo@localhost:5432/ticketchain_test
JWT_SECRET=local-demo-only-replace-with-32-random-bytes
WEB_ORIGIN=http://localhost:5173
PAYMENT_PROVIDER=demo
# Explicit public demo opt-in; production otherwise rejects simulated payments.
ALLOW_DEMO_PAYMENTS=false
DEMO_DATABASE_NAME=ticketchain_demo
# Optional: Razorpay TEST credentials only; never falls back to demo.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Optional Aptos testnet, standard unrotated Ed25519 accounts only.
# APTOS_TREASURY=0x...
# APTOS_PRIVATE_KEY=ed25519-priv-...
# APTOS_MODULE=0x...

# Optional social sign-in (both values required for each enabled provider).
# Register exact callback URLs using WEB_ORIGIN, e.g.:
# http://localhost:8080/api/v1/auth/oauth/google/callback
# http://localhost:8080/api/v1/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Docker services use separate databases and RSA keys generated by bootstrap.
# Set a shared random internal credential before non-local deployment.
SERVICE_TOKEN=local-internal-service-token-replace-in-production
# SERVICE_NAME=standalone
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://ticketchain:localbroker@localhost:5672
# ELASTICSEARCH_URL=http://localhost:9200

# Identity avatar storage; back up the bucket with the Identity database.
AVATAR_S3_ENDPOINT=http://localhost:9000
AVATAR_S3_BUCKET=avatars
AVATAR_S3_ACCESS_KEY=localavatars
AVATAR_S3_SECRET_KEY=local-avatar-storage-replace-in-production
