{
  "name": "@ticketchain/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "node scripts/clean-build.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "ops": "tsx --env-file-if-exists=../../.env scripts/ops.ts",
    "legacy": "tsx --env-file-if-exists=../../.env scripts/legacy.ts",
    "contention": "tsx --env-file-if-exists=../../.env scripts/contention.ts",
    "services:database": "tsx scripts/service-databases.ts",
    "db:cleanup": "node dist/scripts/cleanup-database.js",
    "services:worker": "node dist/src/shared/workers/entry.js",
    "demo:imagery": "tsx scripts/demo-imagery.ts",
    "search:rebuild": "tsx scripts/rebuild-search.ts",
    "queue:ops": "tsx scripts/queue-ops.ts",
    "start:identity": "node dist/src/services/identity/server.js",
    "start:booking": "node dist/src/services/booking/server.js",
    "worker:booking": "node dist/src/services/booking/worker.js",
    "start:payments": "node dist/src/services/payments/server.js",
    "worker:payments": "node dist/src/services/payments/worker.js",
    "start:catalog": "node dist/src/services/catalog/server.js",
    "worker:catalog": "node dist/src/services/catalog/worker.js"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.1.1",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@prisma/client": "6.19.3",
    "@ticketchain/blockchain": "*",
    "@ticketchain/shared": "*",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "prisma": "6.19.3"
  }
}
